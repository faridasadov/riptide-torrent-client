{
  "name": "riptide-desktop",
  "version": "0.1.11",
  "private": true,
  "description": "Native desktop shell for the Riptide torrent client.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:backend": "pyinstaller ../backend/riptide-backend.spec --distpath ../backend/dist --workpath ../backend/build --noconfirm --clean",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "npm run build:backend && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.riptide.desktop",
    "productName": "Riptide",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent metadata",
        "role": "Editor"
      }
    ],
    "linux": {
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ],
      "mimeTypes": [
        "application/x-bittorrent",
        "x-scheme-handler/magnet"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../backend/dist/riptide-backend.exe",
          "to": "backend/riptide-backend.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Riptide"
    },
    "protocols": {
      "name": "Magnet URI",
      "schemes": [
        "magnet"
      ]
    }
  }
}
