{
  "name": "riptide-desktop",
  "version": "0.1.10",
  "private": true,
  "description": "Native desktop shell for the Riptide torrent client.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.riptide.desktop",
    "productName": "Riptide",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent metadata",
        "role": "Editor"
      }
    ],
    "linux": {
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ],
      "mimeTypes": [
        "application/x-bittorrent",
        "x-scheme-handler/magnet"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "protocols": {
      "name": "Magnet URI",
      "schemes": [
        "magnet"
      ]
    }
  }
}
